vault=rvc-vault
tree.block=40_DECIDE
tree.create=00_INBOX
tree.defer=50_DEFERRED
tree.done=60_DONE
tree.evict=90_ARCHIVE/done
tree.review=60_DONE
tree.roadmap=10_CONTEXT
tree.start=30_ACTIVE
tree.supersede=90_ARCHIVE/superseded
tree.triage=20_NEXT

mint.STORY=43

mint.BUG=10


# Domain rulings (human, survive every refresh). A census can drop a type used as a
# tag and fold a word spelled two ways; it cannot decide that two names are one
# invariant. Each line below says: this slug owns nothing the target does not.
domain-alias.owed=ask
domain-alias.scanner=ask
domain-alias.automation=arena
domain-alias.turn-runner=rvcd
domain-alias.presence=avatar
domain-alias.telegram=avatar
domain-alias.triage=governance

# Domain vocabulary — GENERATED by `rvc doctor` from the tags in the open buckets.
# Do not hand-edit the list: it is a rendering of the tree, not a second source of
# truth. Type-as-tag slugs and spelling variants are filtered out; a slug with nothing
# open in it survives only because a human wrote what it owns — the label is the claim.
# `rvc plate` validates live tags against this list; `domain-alias.<old>=<kept>` lines
# anywhere in the marker are rulings the refresh applies instead of second-guessing.
domain.arena=the debate engine: tables, deliberations, turn running
domain.ask=the ask grammar: minted asks, owed turns, the attention scanner
domain.avatar=the Telegram presence: outbound pings and digests
domain.cross-vault=anything delivered outside this vault: provenance, aliases, lanes
domain.feedback=FEEDBACK letters arriving from other vaults
domain.governance=auditing that law: doctor, constitution drift, triage rules
domain.notifications=delivery to a human, whoever produced the notice
domain.plate=the plate: lanes, the DOMAINS block, PLATE.md renderings
domain.protocol=this vault's own law: PROTOCOL/REGLAMENT/AGENTS, the tree map
domain.rvc=the tool itself: ids, buckets, transitions, git sync, help
domain.rvcd=the daemon runtime that runs arena turns (not the debate itself)
